{
  "name": "m3-kit",
  "version": "0.1.0-beta.0",
  "description": "CLI to add Material 3 components to your project from the m3 shadcn registry.",
  "keywords": ["material-3", "material-design-3", "m3", "shadcn", "components", "ui", "react", "tailwind"],
  "license": "MIT",
  "author": "Nathan Mwai",
  "homepage": "https://m3.nathanmwai.com",
  "repository": {
    "type": "git",
